# ============================================================
# VisCurator / CVAgent — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# NVIDIA NIM API key (required)
# Obtain from https://build.nvidia.com
NVIDIA_API_KEY=your_key_here

# HuggingFace token (optional – needed for gated datasets)
HF_TOKEN=optional_huggingface_token

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
