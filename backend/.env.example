# ============================================================
# VisCurator / CVAgent — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# NVIDIA NIM API key (required)
# Obtain from https://build.nvidia.com
NVIDIA_API_KEY=your_key_here

# HuggingFace token (optional – needed for gated datasets)
HF_TOKEN=optional_huggingface_token

# Kaggle credentials (optional – enables Kaggle dataset search)
# Obtain from https://www.kaggle.com/account → API → Create New Token
# The downloaded kaggle.json contains your username and key.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Roboflow API key (optional – enables Roboflow Universe dataset search)
# Obtain a free key at https://roboflow.com → Settings → Roboflow API
ROBOFLOW_API_KEY=your_roboflow_api_key

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
